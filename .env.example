# Aggregator core (central_mcp). In production the reverse proxy routes the core API directly.
CENTRAL_MCP_API_URL=http://localhost:8000

# Database (PostgreSQL)
DATABASE_URL=postgresql://portal:change-me@localhost:5433/portal

# Better Auth
BETTER_AUTH_URL=http://localhost:3100
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local administrator, created or updated by `npm run seed:admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Browser tests only (`npm run seed:e2e`); never set in production
E2E_ADVERTISER_EMAIL=
E2E_ADVERTISER_PASSWORD=

# Brand of this deployment (read at runtime; all optional)
BRAND_NAME=
BRAND_SHORT_NAME=
BRAND_TAGLINE=
BRAND_REGION_LABEL=
BRAND_PRIMARY_COLOR=
BRAND_ACCENT_COLOR=
BRAND_LOGO_URL=
BRAND_SUPPORT_EMAIL=
